{
	"name": "zimuarr",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"prepare": "bun --bun svelte-kit sync && bun --bun panda codegen",
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun ./build",
		"check": "bun --bun svelte-kit sync && bun --bun panda codegen && bun --bun svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "bun --bun vitest run --project unit",
		"smoke": "bun --bun playwright test",
		"lint": "bun --bun biome ci",
		"contract:up": "bun tests/contract/setup.ts up",
		"contract": "bun --bun vite build && bun --bun vitest run --project contract",
		"contract:full": "bun --bun vite build && CONTRACT_FULL=1 bun --bun vitest run --project contract",
		"contract:down": "bun tests/contract/setup.ts down"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#styled-system/*": "./styled-system/*/index.js"
	},
	"devDependencies": {
		"@ark-ui/svelte": "5.25.0",
		"@biomejs/biome": "2.6.5",
		"@pandacss/dev": "2.4.0",
		"@pandacss/preset-base": "2.4.0",
		"@pandacss/vite": "2.4.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-bun": "1.0.0",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.1.0"
	}
}
